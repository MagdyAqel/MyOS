{
  "name": "myos-desktop",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.unit.js && playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.js",
    "dev:multiplayer": "node scripts/arena-worker.mjs dev",
    "deploy:multiplayer": "node scripts/arena-worker.mjs deploy",
    "test:multiplayer": "playwright test --config playwright.multiplayer.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "jsqr": "1.4.0",
    "vite": "7.2.2",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "three": "0.180.0"
  }
}
