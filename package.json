{
  "name": "myos-desktop",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.unit.js && playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.2.2"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
